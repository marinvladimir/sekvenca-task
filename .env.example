# Kopiraj u .env (opcionalno). .env se NIKAD ne commita.

# claude-code (zadano): Claude Code CLI s tvojom Claude pretplatom, bez API ključa
# api: izravni Claude API, treba ANTHROPIC_API_KEY
KADAR_LLM_BACKEND=claude-code
# Samo za KADAR_LLM_BACKEND=api; zadani backend (claude-code) koristi `claude auth login`
ANTHROPIC_API_KEY=
# Model (može se promijeniti bez promjene koda)
KADAR_TEXT_MODEL=claude-opus-5-5

# Scraping
KADAR_USER_AGENT=Mozilla/5.0 (compatible; KadarRecipe/0.1)
KADAR_REQUEST_DELAY_S=1.0
